---
import '../styles/mp-styles.css';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ProximamenteBar from '../components/ProximamenteBar.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import ProveedoresSection from '../components/ProveedoresSection.astro';
import Seguridad from '../components/Seguridad.astro';
import ParaProveedores from '../components/ParaProveedores.astro';
import ContactSection from '../components/ContactSection.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';

const titulo = 'MicoPay — Tu dinero, cerca de ti';
const descripcion = 'Cambia USDC por pesos en efectivo con una persona real de tu colonia. Escrow en Stellar, sin banco, sin trámites.';
const sitio = 'https://micopay.com.mx';

// Datos estructurados (JSON-LD). Las preguntas y respuestas de FAQPage
// deben coincidir palabra por palabra con el array FAQS de Faq.jsx.
const jsonLdOrganization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'MicoPay',
  url: sitio,
  logo: `${sitio}/favicon.svg`,
  sameAs: ['https://github.com/Micopay'],
};

const jsonLdWebSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'MicoPay',
  url: sitio,
  inLanguage: 'es-MX',
};

const jsonLdFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    ['¿Por qué MicoPay?', 'Por el micelio: la red de hilos con la que los hongos se conectan bajo tierra y reparten nutrientes entre árboles que nunca se tocan. No hay un centro que mande, y aun así funciona. MicoPay se organiza igual — una red de personas y negocios de tu colonia moviendo efectivo de mano en mano, sin un banco en medio. Cada proveedor es un nodo, y el escrow en Stellar es lo que sostiene la confianza entre desconocidos.'],
    ['¿Cómo funciona el escrow?', 'Al iniciar la operación tus USDC quedan bloqueados en un contrato inteligente. El proveedor solo los cobra cuando confirmas que recibiste tu efectivo. Si no se concreta, el reembolso es automático y completo.'],
    ['¿Cuánto me cuesta?', 'No hay una tarifa única: cada proveedor pone la suya, normalmente entre 1.9% y 2.5%, más una comisión de plataforma pequeña. Antes de aceptar ves el monto exacto en pesos que vas a recibir, ya con todo descontado — nunca hay cobros después.'],
    ['¿Necesito cuenta bancaria?', 'No. MicoPay está diseñado para quien no tiene acceso bancario: solo necesitas una billetera, y la app te ayuda a crearla en un minuto.'],
    ['¿Qué pasa si el proveedor no aparece?', 'Cancelas desde la app y tus USDC regresan íntegros. El incidente afecta la reputación en cadena del proveedor, que es pública.'],
    ['¿Sirve para recibir remesas?', 'Sí. Quien te envía manda USDC desde cualquier país y tú retiras pesos en efectivo cerca de casa, sin las comisiones de las casas de cambio tradicionales.'],
    ['¿Cuándo abre en mi ciudad?', 'Estamos activando ciudad por ciudad según el interés registrado. Déjanos tu correo abajo y te avisamos apenas abra la tuya.'],
  ].map(([pregunta, respuesta]) => ({
    '@type': 'Question',
    name: pregunta,
    acceptedAnswer: {
      '@type': 'Answer',
      text: respuesta,
    },
  })),
};
---
<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={sitio} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block" rel="stylesheet" />

  <!-- Open Graph / Twitter Card -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={sitio} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:site_name" content="MicoPay" />
  <meta property="og:locale" content="es_MX" />
  <meta property="og:image" content={`${sitio}/og.jpg`} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={titulo} />
  <meta name="twitter:description" content={descripcion} />
  <meta name="twitter:image" content={`${sitio}/og.jpg`} />

  <!-- Datos estructurados -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdOrganization)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebSite)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />

  <!-- Turnstile: se carga async, no bloquea el render del formulario. -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body>
  <Nav />
  <main>
    <Hero />
    <ProximamenteBar />
    <ComoFunciona />
    <ProveedoresSection />
    <Seguridad />
    <ParaProveedores />
    <ContactSection />
    <FaqSection />
    <CtaFinal />
  </main>
  <Footer />
</body>
</html>

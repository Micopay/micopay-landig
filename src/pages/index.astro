---
import '../styles/mp-styles.css';
import { FAQS } from '../data/faqs.js';
import Nav from '../components/Nav.astro';
import AvisoBeta from '../components/AvisoBeta.astro';
import Hero from '../components/Hero.astro';
import ProximamenteBar from '../components/ProximamenteBar.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import ProveedoresSection from '../components/ProveedoresSection.astro';
import Seguridad from '../components/Seguridad.astro';
import ParaProveedores from '../components/ParaProveedores.astro';
import ContactSection from '../components/ContactSection.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';

const titulo = 'MicoPay — Tu dinero, cerca de ti';
const descripcion = 'Cambia USDC por pesos en efectivo con una persona real de tu colonia. Escrow en Stellar, sin banco, sin trámites.';
const sitio = 'https://micopay.com.mx';

// Datos estructurados (JSON-LD).
const jsonLdOrganization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'MicoPay',
  url: sitio,
  logo: `${sitio}/favicon.svg`,
  sameAs: ['https://github.com/Micopay'],
};

const jsonLdWebSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'MicoPay',
  url: sitio,
  inLanguage: 'es-MX',
};

const jsonLdFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  // Se arma desde `data/faqs.js`, el mismo array que pinta el acordeón,
  // para que el marcado nunca diga algo distinto a lo que se ve en pantalla.
  mainEntity: FAQS.map(([pregunta, respuesta]) => ({
    '@type': 'Question',
    name: pregunta,
    acceptedAnswer: {
      '@type': 'Answer',
      text: respuesta,
    },
  })),
};
---
<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={sitio} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block" rel="stylesheet" />

  <!-- Open Graph / Twitter Card -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={sitio} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:site_name" content="MicoPay" />
  <meta property="og:locale" content="es_MX" />
  <meta property="og:image" content={`${sitio}/og.jpg`} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={titulo} />
  <meta name="twitter:description" content={descripcion} />
  <meta name="twitter:image" content={`${sitio}/og.jpg`} />

  <!-- Datos estructurados -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdOrganization)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebSite)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />

  <!-- Turnstile: se carga async, no bloquea el render del formulario. -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body>
  <Nav />
  <AvisoBeta />
  <main>
    <Hero />
    <ProximamenteBar />
    <ComoFunciona />
    <ProveedoresSection />
    <Seguridad />
    <ParaProveedores />
    <ContactSection />
    <FaqSection />
    <CtaFinal />
  </main>
  <Footer />
</body>
</html>

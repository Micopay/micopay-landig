---
/* Layout de las páginas legales. Reusa nav y footer del sitio, pero con
   tipografía de lectura larga y `noindex`: no queremos que compitan en
   buscadores con la landing. */
import '../styles/mp-styles.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titulo: string;
  descripcion: string;
  actualizado: string;
}
const { titulo, descripcion, actualizado } = Astro.props;
---
<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo} · MicoPay</title>
  <meta name="description" content={descripcion} />
  <meta name="robots" content="noindex, follow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block" rel="stylesheet" />
</head>
<body>
  <Nav />
  <main class="legal">
    <div class="container legal-in">
      <a href="/" class="volver"><span class="ms">arrow_back</span>Volver al inicio</a>
      <h1 class="legal-h1">{titulo}</h1>
      <p class="legal-fecha">Última actualización: {actualizado}</p>
      <div class="legal-cuerpo">
        <slot />
      </div>
    </div>
  </main>
  <Footer />
</body>
</html>

<style is:global>
  .legal { padding: 56px 0 88px; background: #fff; }
  .legal-in { max-width: 760px; }
  .volver {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 14px; font-weight: 700; color: var(--gris); margin-bottom: 28px;
  }
  .volver:hover { color: var(--verde); }
  .volver .ms { font-size: 18px; }
  .legal-h1 { font-size: clamp(30px, 4vw, 42px); line-height: 1.1; margin-bottom: 10px; }
  .legal-fecha { font-size: 14px; color: var(--gris-2); font-weight: 600; margin-bottom: 40px; }

  .legal-cuerpo { color: var(--gris); font-size: 16.5px; line-height: 1.75; }
  .legal-cuerpo h2 {
    font-size: 22px; color: var(--tinta); margin: 40px 0 14px; letter-spacing: -.02em;
  }
  .legal-cuerpo h3 {
    font-size: 17px; color: var(--tinta); margin: 26px 0 10px; letter-spacing: -.01em;
  }
  .legal-cuerpo p { margin-bottom: 16px; }
  .legal-cuerpo ul { margin: 0 0 18px 22px; }
  .legal-cuerpo li { margin-bottom: 9px; }
  .legal-cuerpo strong { color: var(--tinta); font-weight: 700; }
  .legal-cuerpo a { font-weight: 600; }

  .legal-cuerpo table {
    width: 100%; border-collapse: collapse; margin: 0 0 22px; font-size: 15px;
  }
  .legal-cuerpo th, .legal-cuerpo td {
    text-align: left; padding: 11px 14px; border-bottom: 1px solid var(--linea); vertical-align: top;
  }
  .legal-cuerpo th {
    background: var(--fondo); color: var(--tinta); font-weight: 700;
    font-size: 13px; text-transform: uppercase; letter-spacing: .04em;
  }

  .aviso-caja {
    background: var(--verde-suave); border: 1px solid var(--verde-borde);
    border-radius: 16px; padding: 20px 24px; margin: 0 0 32px;
  }
  .aviso-caja p { margin: 0; color: var(--verde); font-size: 15px; }
  .aviso-caja strong { color: var(--verde); }

  .pendiente {
    background: #fff8e6; border: 1px solid #f0d99b; border-radius: 8px;
    padding: 2px 8px; font-size: 14px; font-weight: 700; color: #8a6417;
    font-family: ui-monospace, monospace;
  }
</style>

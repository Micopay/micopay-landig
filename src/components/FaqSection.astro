---
import Faq from './Faq.jsx';
---
<section id="faq" class="section section--white">
  <div class="container container--angosto">
    <div class="intro">
      <div class="label">Preguntas frecuentes</div>
      <h2 class="h2">Lo que todos preguntan</h2>
    </div>
    <Faq client:visible />
  </div>
</section>

<style>
  .container--angosto { max-width: 900px; }
  .intro { text-align: center; margin-bottom: 48px; }
  .h2 { font-size: clamp(30px, 3.6vw, 44px); line-height: 1.1; }
</style>

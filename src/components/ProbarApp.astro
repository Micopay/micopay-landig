---
/* Invitacion a la beta de la app web. Por ahora solo se entra con Varial en
   una PC; los pasos cambian cuando la app del telefono firme para la web. */
const pasos = [
  {
    titulo: 'Instala Varial',
    texto: 'Es una billetera de Stellar para tu navegador. Descárgala solo desde su sitio oficial y crea una billetera nueva para estas pruebas.',
  },
  {
    titulo: 'Cambia a Testnet',
    texto: 'En Varial, elige la red Testnet. Ahí puedes pedir XLM de prueba para activar tu cuenta.',
  },
  {
    titulo: 'Entra a la app',
    texto: 'Abre la app, toca “Conectar billetera” y aprueba en Varial la firma de inicio de sesión. Esa firma no mueve fondos.',
  },
];
---
<section id="probar" class="probar">
  <div class="container">
    <span class="cintillo">Ya estamos en pruebas</span>
    <h2 class="titulo">Prueba MicoPay desde tu computadora</h2>
    <p class="intro">
      La app web ya está abierta en red de prueba. Es una beta y puede fallar. Tus comentarios nos ayudan a dejarla lista.
    </p>

    <ol class="pasos">
      {pasos.map((p, i) => (
        <li class="paso">
          <span class="num">{i + 1}</span>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </li>
      ))}
    </ol>

    <div class="acciones">
      <a href="https://app.micopay.com.mx" class="btn btn--primary">
        <span class="ms">open_in_new</span>Abrir la app
      </a>
      <a href="https://varialwallet.com" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">
        Instalar Varial<span class="ms">download</span>
      </a>
    </div>

    <p class="cuidado">
      <span class="ms">shield</span>
      <span>
        <strong>Usa solo la red de prueba.</strong> No envíes dinero real. Nadie de MicoPay te va a
        pedir tu frase de recuperación: quien te la pida quiere quitarte tus fondos.
      </span>
    </p>
  </div>
</section>

<style>
  .probar { scroll-margin-top: 80px; padding: 72px 0; background: var(--papel); border-top: 2px solid var(--tinta); }
  .cintillo {
    display: inline-block; background: var(--tinta); color: var(--papel); padding: 5px 10px;
    font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
  }
  .titulo { font-size: clamp(28px, 3.4vw, 40px); margin: 14px 0 12px; }
  .intro { font-size: 17px; color: var(--gris); max-width: 38em; margin-bottom: 32px; }
  .pasos {
    list-style: none; padding: 0; margin: 0 0 28px;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px;
  }
  .paso { background: var(--fondo); border: 2px solid var(--tinta); border-radius: var(--r-sm); padding: 22px; }
  .num {
    display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px;
    background: var(--naranja); color: var(--papel); border-radius: var(--r-sm);
    font-family: var(--font-display); font-weight: 800; margin-bottom: 12px;
  }
  .paso h3 { font-size: 19px; margin-bottom: 6px; }
  .paso p { font-size: 15px; color: var(--gris); }
  .acciones { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 24px; }
  .cuidado { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; color: var(--gris); max-width: 46em; }
  .cuidado .ms { font-size: 20px; color: var(--naranja); flex-shrink: 0; }
  .cuidado strong { color: var(--tinta); }
  @media (max-width: 700px) { .probar { scroll-margin-top: 230px; } }
</style>

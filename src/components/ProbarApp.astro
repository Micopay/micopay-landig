---
/* Invitacion a la beta de la app web. Se entra en una PC con Varial o con la
   app MicoPay del telefono, que firma para la web por WalletConnect. */
const pasosApp = [
  {
    titulo: 'Elige la app MicoPay',
    texto: 'En la app web, toca “Conectar billetera” y elige “App MicoPay (WalletConnect)”. Aparece un código QR.',
  },
  {
    titulo: 'Escanea desde tu teléfono',
    texto: 'En la app MicoPay, ve a Perfil → Conexiones web → Escanear QR de la web y aprueba la conexión.',
  },
  {
    titulo: 'Firma en tu teléfono',
    texto: 'Aprueba con tu huella la firma de inicio de sesión. Tu llave nunca sale del teléfono: cada firma la apruebas ahí.',
  },
];

const pasos = [
  {
    titulo: 'Instala Varial',
    texto: 'Es una billetera de Stellar para tu navegador. Descárgala solo desde su sitio oficial y crea una billetera nueva para estas pruebas.',
  },
  {
    titulo: 'Cambia a Testnet',
    texto: 'En Varial, elige la red Testnet. Ahí puedes pedir XLM de prueba para activar tu cuenta.',
  },
  {
    titulo: 'Entra a la app',
    texto: 'Abre la app, toca “Conectar billetera” y aprueba en Varial la firma de inicio de sesión. Esa firma no mueve fondos.',
  },
];
---
<section id="probar" class="probar">
  <div class="container">
    <span class="cintillo">Ya estamos en pruebas</span>
    <h2 class="titulo">Prueba MicoPay desde tu computadora</h2>
    <p class="intro">
      La app web ya está abierta en red de prueba. Es una beta y puede fallar. Tus comentarios nos ayudan a dejarla lista.
    </p>

    <p class="aviso-tel solo-tel">
      <strong>Estás en tu teléfono.</strong> La app web se usa en computadora, con Varial o
      con la app MicoPay de tu teléfono. Copia el enlace y ábrelo ahí, o déjanos tu correo.
    </p>

    <div class="con-app">
      <span class="nuevo">Nuevo</span>
      <h3 class="subtitulo">¿Ya usas la app MicoPay en tu teléfono?</h3>
      <p class="sub-intro">Entra a la app web con esa misma cuenta. No tienes que instalar nada más en la computadora.</p>
      <ol class="pasos">
        {pasosApp.map((p, i) => (
          <li class="paso">
            <span class="num">{i + 1}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>

    <h3 class="subtitulo">¿No tienes la app? Entra con Varial</h3>
    <ol class="pasos">
      {pasos.map((p, i) => (
        <li class="paso">
          <span class="num">{i + 1}</span>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </li>
      ))}
    </ol>

    <div class="acciones">
      <a href="https://app.micopay.com.mx" class="btn btn--primary solo-pc">
        <span class="ms">open_in_new</span>Abrir la app
      </a>
      <a href="https://varialwallet.com" target="_blank" rel="noopener noreferrer" class="btn btn--ghost solo-pc">
        Instalar Varial<span class="ms">download</span>
      </a>
      <button type="button" class="btn btn--primary solo-tel" id="copiar-enlace">
        <span class="ms">content_copy</span><span id="copiar-t">Copiar enlace de la app</span>
      </button>
      <a href="#lead" class="btn btn--ghost solo-tel">
        Avísame por correo<span class="ms">near_me</span>
      </a>
    </div>

    <p class="cuidado">
      <span class="ms">shield</span>
      <span>
        <strong>Usa solo la red de prueba.</strong> No envíes dinero real. Nadie de MicoPay te va a
        pedir tu frase de recuperación: quien te la pida quiere quitarte tus fondos.
      </span>
    </p>
  </div>
</section>

<style>
  .probar { scroll-margin-top: 80px; padding: 72px 0; background: var(--papel); border-top: 2px solid var(--tinta); }
  .cintillo {
    display: inline-block; background: var(--tinta); color: var(--papel); padding: 5px 10px;
    font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
  }
  .titulo { font-size: clamp(28px, 3.4vw, 40px); margin: 14px 0 12px; }
  .intro { font-size: 17px; color: var(--gris); max-width: 38em; margin-bottom: 32px; }
  .pasos {
    list-style: none; padding: 0; margin: 0 0 28px;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px;
  }
  .paso { background: var(--fondo); border: 2px solid var(--tinta); border-radius: var(--r-sm); padding: 22px; }
  .num {
    display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px;
    background: var(--naranja); color: var(--papel); border-radius: var(--r-sm);
    font-family: var(--font-display); font-weight: 800; margin-bottom: 12px;
  }
  .paso h3 { font-size: 19px; margin-bottom: 6px; }
  .paso p { font-size: 15px; color: var(--gris); }
  .con-app { border: 2px solid var(--tinta); border-radius: var(--r-sm); padding: 22px; margin-bottom: 32px; background: var(--naranja-suave); }
  .con-app .pasos { margin-bottom: 0; }
  .con-app .paso { background: var(--papel); }
  .nuevo {
    display: inline-block; background: var(--naranja); color: var(--papel); padding: 3px 8px;
    font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; border-radius: var(--r-sm);
  }
  .subtitulo { font-size: 22px; margin: 10px 0 8px; }
  .sub-intro { font-size: 15px; color: var(--gris); margin-bottom: 18px; max-width: 40em; }
  .acciones { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 24px; }
  .cuidado { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; color: var(--gris); max-width: 46em; }
  .cuidado .ms { font-size: 20px; color: var(--naranja); flex-shrink: 0; }
  .cuidado strong { color: var(--tinta); }

  .aviso-tel {
    background: var(--naranja-suave); border: var(--borde); border-radius: var(--r-sm);
    padding: 14px 16px; font-size: 15px; color: var(--tinta); margin-bottom: 20px;
  }
  @media (max-width: 760px) {
    .probar { padding: 48px 0; }
    .intro { font-size: 16px; margin-bottom: 20px; }
    .pasos { gap: 12px; margin-bottom: 22px; }
    /* Numero y titulo en la misma linea: tres tarjetas caben en una pantalla */
    .paso { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 12px; align-items: center; padding: 16px; }
    .num { margin-bottom: 0; }
    .paso h3 { margin-bottom: 0; }
    .paso p { grid-column: 1 / -1; margin-top: 8px; }
    .con-app { padding: 16px; margin-bottom: 24px; }
    .subtitulo { font-size: 19px; }
    .acciones { gap: 12px; }
    .acciones .btn { width: 100%; justify-content: center; }
  }
</style>

<script>
  const copiar = document.getElementById('copiar-enlace');
  const texto = document.getElementById('copiar-t');
  copiar?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('https://app.micopay.com.mx');
      if (texto) texto.textContent = 'Enlace copiado';
    } catch {
      if (texto) texto.textContent = 'app.micopay.com.mx';
    }
  });
</script>

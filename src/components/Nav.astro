---
---
<header class="nav">
  <div class="container nav-in">
    <a href="#top" class="brand">
      <svg fill="none" height="28" width="28" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <circle cx="7" cy="7" r="3" stroke="#16130F" stroke-width="2.5"></circle>
        <circle class="marca-acento" cx="17" cy="17" r="3" stroke-width="2.5"></circle>
        <path d="M10 10L14 14" stroke="#16130F" stroke-linecap="round" stroke-width="2.5"></path>
      </svg>
      <span class="brand-t" translate="no">Mico<span class="brand-accent">Pay</span></span>
    </a>
    <nav id="nav-menu" class="nav-links">
      <a href="#como-funciona">Cómo funciona</a>
      <a href="#proveedores">Proveedores</a>
      <a href="#seguridad">Seguridad</a>
      <a href="#ser-proveedor" class="solo-tel">Ser proveedor</a>
      <a href="#lead">Registrarme</a>
    </nav>
    <div class="nav-cta">
      <a href="#ser-proveedor" class="nav-secundario solo-pc">Ser proveedor</a>
      <a href="https://app.micopay.com.mx" class="btn btn--primary nav-btn solo-pc">
        <span class="ms">open_in_new</span>Abrir app
      </a>
      <a href="#probar" class="btn btn--primary nav-btn solo-tel">Probar</a>
      <button type="button" class="nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-menu">
        <span class="ms">menu</span>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: var(--fondo);
    border-bottom: 2px solid var(--tinta);
  }
  .nav-in {
    min-height: 72px; padding-top: 12px; padding-bottom: 12px;
    display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap;
  }
  .brand { display: flex; align-items: center; gap: 10px; color: inherit; }
  /* El acento del logo va por token, no por hex: el nav es fondo claro, así
     que le toca --naranja. Antes estaba incrustado como #D9420B y se quedó
     atrás cuando el naranja pasó a ser direccional. */
  .marca-acento { stroke: var(--naranja); }
  .brand-t {
    font-family: var(--font-display); font-weight: 800; font-size: 20px;
    letter-spacing: -.02em; color: var(--tinta); text-transform: uppercase;
    font-variation-settings: "wdth" 112;
  }
  .brand-accent { color: var(--naranja); }
  .nav-links { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
  .nav-links a { font-size: 14px; font-weight: 600; color: var(--gris); white-space: nowrap; }
  .nav-links a:hover { color: var(--naranja); }
  .nav-cta { display: flex; align-items: center; gap: 10px; }
  .nav-secundario { font-size: 14px; font-weight: 700; color: var(--tinta); padding: 9px 12px; border-radius: var(--r-sm); }
  .nav-secundario:hover { background: var(--verde-suave); }
  .nav-btn { padding: 10px 18px; font-size: 14px; }
  .nav-btn .ms { font-size: 18px; }
  .nav-toggle { display: none; }

  /* En el telefono el nav es sticky: si crece, le quita pantalla a todo. Queda
     en una sola fila y los enlaces viven en un panel que se abre con el boton. */
  @media (max-width: 760px) {
    .nav-in { min-height: 60px; padding-top: 8px; padding-bottom: 8px; gap: 10px; flex-wrap: nowrap; position: relative; }
    .nav-cta { gap: 8px; }
    .nav-btn { padding: 8px 14px; min-height: 44px; }
    .nav-btn:active { transform: none; }
    .nav-toggle {
      display: inline-flex; align-items: center; justify-content: center;
      width: 44px; height: 44px; background: var(--papel); color: var(--tinta);
      border: var(--borde); border-radius: var(--r-sm); cursor: pointer;
    }
    .nav-links {
      display: none; position: absolute; top: 100%; left: 0; right: 0;
      background: var(--fondo); border-top: 2px solid var(--tinta); border-bottom: 2px solid var(--tinta);
      padding: 6px 24px 10px; flex-direction: column; align-items: stretch; gap: 0; margin-top: 2px;
    }
    .nav-links.abierto { display: flex; }
    .nav-links a { display: flex; align-items: center; min-height: 48px; font-size: 16px; color: var(--tinta); }
    .nav-links a + a { border-top: 1px solid var(--linea); }
  }
</style>

<script>
  const boton = document.querySelector('.nav-toggle');
  const menu = document.getElementById('nav-menu');
  const icono = boton?.querySelector('.ms');
  const poner = (abierto) => {
    menu?.classList.toggle('abierto', abierto);
    boton?.setAttribute('aria-expanded', String(abierto));
    boton?.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
    if (icono) icono.textContent = abierto ? 'close' : 'menu';
  };
  boton?.addEventListener('click', () => poner(!menu?.classList.contains('abierto')));
  menu?.addEventListener('click', (e) => { if (e.target.closest('a')) poner(false); });
</script>

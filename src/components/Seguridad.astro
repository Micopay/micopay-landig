---
const items = [
  { icon: 'lock', titulo: 'Escrow en cadena', texto: 'Tus USDC se bloquean al iniciar. Si algo falla, vuelven completos a tu billetera.' },
  { icon: 'no_accounts', titulo: 'Sin cuenta bancaria', texto: 'Pensado para quien no tiene cuenta. La app crea tu billetera en menos de un minuto.' },
  { icon: 'fact_check', titulo: 'Reputación verificable', texto: 'Cada operación queda registrada. La reputación de un proveedor no se puede inventar.' },
];
---
<section id="seguridad" class="section section--dark">
  <div class="container">
    <div class="intro">
      <div class="label label--claro">Seguridad</div>
      <h2 class="h2">El proveedor cobra hasta que tú tienes el efectivo</h2>
      <p class="intro-p">No es una promesa comercial: es un contrato inteligente en Stellar que cualquiera puede leer y verificar.</p>
    </div>

    <div class="grid">
      {items.map((it) => (
        <div class="tarjeta">
          <span class="ms tarjeta-icon">{it.icon}</span>
          <h3 class="tarjeta-t">{it.titulo}</h3>
          <p class="tarjeta-p">{it.texto}</p>
        </div>
      ))}
    </div>

    <div class="flujo">
      <div class="paso-flujo">
        <div class="circulo">
          <span class="ms">person</span>
        </div>
        <div class="paso-flujo-t">Tú</div>
        <div class="paso-flujo-p">Depositas USDC</div>
      </div>
      <span class="ms flecha">arrow_forward</span>
      <div class="paso-flujo">
        <div class="circulo circulo--grande">
          <span class="ms">lock</span>
        </div>
        <div class="paso-flujo-t" style="color: var(--naranja-claro);">Escrow</div>
        <div class="paso-flujo-p">Smart contract Soroban</div>
      </div>
      <span class="ms flecha">arrow_forward</span>
      <div class="paso-flujo">
        <div class="circulo">
          <span class="ms">storefront</span>
        </div>
        <div class="paso-flujo-t">Proveedor</div>
        <div class="paso-flujo-p">Entrega el efectivo</div>
      </div>
    </div>
  </div>
</section>

<style>
  .intro { max-width: 640px; margin-bottom: 56px; }
  .h2 { font-size: clamp(30px, 3.6vw, 44px); line-height: 1.1; margin-bottom: 16px; }
  .intro-p { font-size: 17px; color: var(--gris-3); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-bottom: 24px; }
  .tarjeta {
    background: var(--papel); border: var(--borde); border-radius: var(--r-sm); padding: 26px;
    color: var(--tinta); box-shadow: 5px 5px 0 var(--naranja);
  }
  .tarjeta-icon { font-size: 28px; color: var(--verde); }
  .tarjeta-t { font-size: 19px; margin: 14px 0 8px; }
  .tarjeta-p { color: var(--gris); font-size: 15px; }

  .flujo {
    background: var(--tinta-2); border: 2px solid var(--tinta-3); border-radius: var(--r-sm); padding: 36px;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, auto)); justify-content: center; align-items: center; gap: 24px;
  }
  .paso-flujo { text-align: center; }
  .circulo {
    width: 54px; height: 54px; margin: 0 auto 12px; border-radius: var(--r-sm);
    background: var(--papel); border: 2px solid var(--papel);
    display: flex; align-items: center; justify-content: center; color: var(--tinta);
  }
  /* El escrow es el nodo que importa: es el único naranja de la cadena */
  .circulo--grande {
    width: 68px; height: 68px; background: var(--naranja); border-color: var(--naranja); color: var(--papel);
  }
  .paso-flujo-t { font-weight: 700; }
  .paso-flujo-p { font-size: 13px; color: var(--gris-3); }
  .flecha { color: var(--gris-2); font-size: 26px; }
</style>
